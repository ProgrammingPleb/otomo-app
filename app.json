{
  "expo": {
    "name": "Otomo",
    "slug": "otomo-app",
    "version": "1.0.0-beta2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "otomoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "moe.pleb.otomo"
    },
    "android": {
      "permissions": [
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "moe.pleb.otomo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A58CDC",
          "image": "./assets/images/github-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/OtomoSans-Thin.ttf",
            "./assets/fonts/OtomoSans-Light.ttf",
            "./assets/fonts/OtomoSans-Regular.ttf",
            "./assets/fonts/OtomoSans-Medium.ttf",
            "./assets/fonts/OtomoSans-SemiBold.ttf",
            "./assets/fonts/OtomoSans-Bold.ttf",
            "./assets/fonts/OtomoSans-ExtraBold.ttf"
          ]
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "icons": [
              {
                "name": "logo",
                "path": "./assets/images/notification.png",
                "type": "small"
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ebef65a-96f4-433d-97a6-b03f310f47b9"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4ebef65a-96f4-433d-97a6-b03f310f47b9"
    }
  }
}
